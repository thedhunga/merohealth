{
  "name": "@swasthya/interop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./pdf": {
      "types": "./src/export-pdf.ts",
      "default": "./dist/export-pdf.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --passWithNoTests"
  },
  "dependencies": {
    "@swasthya/health-records": "workspace:*",
    "@swasthya/shared-types": "workspace:*",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
