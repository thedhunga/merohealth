{
  "name": "@swasthya/storage-adapters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./hosted": {
      "types": "./src/hosted-store.ts",
      "default": "./dist/hosted-store.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --passWithNoTests"
  },
  "dependencies": {
    "@swasthya/entitlements": "workspace:*",
    "@swasthya/shared-types": "workspace:*",
    "minio": "8.0.7"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "@types/s3rver": "3.7.4",
    "s3rver": "3.7.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
