// ------------------------------------------------------------------------
// Personal health platform (docs/architecture/platform-vision.md). Unlike
// the models above, none of these declare a Prisma `@relation` to another
// model here — every id-shaped field (ownerId, documentId) is a plain
// scalar column, matching this file's existing convention of not wiring
// cross-model foreign keys at the ORM level, since packages are meant to
// stay extraction-ready into separate services.
//
// `ownerId` is deliberately a plain String, not `@db.Uuid`: there is no
// identity/auth layer yet (see apps/api's FreeTierSubscriptionResolver doc
// comment), so it is just whatever client-supplied string the caller sent,
// same as `RecordsController`'s own validation.

model HealthDocument {
  id              String         @id @default(uuid()) @db.Uuid
  ownerId         String
  kind            String
  status          DocumentStatus @default(CAPTURED)
  storageBackend  String
  externalRef     String
  byteSize        BigInt
  contentType     String?
  checksumSha256  String
  title           String
  documentDate    DateTime?
  capturedAt      DateTime       @default(now())
  sensitivity     String         @default("STANDARD")
  clientEncrypted Boolean        @default(false)
  pageCount       Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  version         Int            @default(1)

  @@index([ownerId, status])
}

model HealthObservation {
  id              String            @id @default(uuid()) @db.Uuid
  documentId      String            @db.Uuid
  ownerId         String
  code            String
  codeSystem      String
  labelNe         String
  labelEn         String
  value           String
  unit            String?
  referenceRange  String?
  abnormalFlag    String?
  effectiveAt     DateTime?
  status          ObservationStatus @default(DRAFT)
  provenance      String
  // Extraction confidence 0-1. Null for non-extracted provenance.
  confidence      Float?
  extractionRunId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  version         Int               @default(1)

  @@index([documentId])
  @@index([ownerId, code])
}

model DeviceSample {
