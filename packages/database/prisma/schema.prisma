model KnowledgeDocument {
  id                String   @id @default(uuid()) @db.Uuid
  knowledgeSourceId String   @db.Uuid
  objectKey         String
  sha256            String
  chunkingVersion   String
  ingestionStatus   String
  createdAt         DateTime @default(now())
  version           Int      @default(1)
}

model Citation {
  id                String   @id @default(uuid()) @db.Uuid
  aiMessageId       String   @db.Uuid
  knowledgeSourceId String   @db.Uuid
  locator           String?
  claimHash         String
  validationStatus  String
  createdAt         DateTime @default(now())
}

model TranslationTerm {
  id             String    @id @default(uuid()) @db.Uuid
  conceptCode    String
  sourceLanguage String
  targetLanguage String
  sourceText     String
  targetText     String
  domain         String
  reviewStatus   String
  effectiveAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  version        Int       @default(1)

  @@unique([conceptCode, targetLanguage, version])
}

model DirectoryEntity {
  id              String             @id @default(uuid()) @db.Uuid
  type            String
  name            String
  nameNe          String?
  verification    VerificationStatus @default(IMPORTED)
  district        String
  municipality    String
  serviceData     Json
  sourceLabel     String
  dataAsOf        DateTime
  isFictionalDemo Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  version         Int                @default(1)
}

model TrainingLesson {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String
  title           Json
  durationSeconds Int
  mediaManifest   Json?
  transcript      Json
  reviewStatus    String
  version         Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([slug, version])
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  actorUserId   String?  @db.Uuid
  actorRole     String?
  action        String
  subjectType   String
  subjectId     String?  @db.Uuid
  purpose       String?
  outcome       String
  correlationId String
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([subjectType, subjectId, createdAt])
}

model FeatureFlag {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique
  description  String
  enabled      Boolean  @default(false)
  rules        Json?
  jurisdiction String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  version      Int      @default(1)
}

// ------------------------------------------------------------------------
// packages/family (docs/architecture/family-and-proxy.md §2/§3). The real
// store the ledger's 2026-08-10/11 entries left as the next honest step:
// `wardId`/`guardianId`/`granterId`/`delegateId` are `User.id` values, the
// same "subjectId" every other Round two table keys on, so — unlike
// `HealthDocument.ownerId`'s deliberately untyped String, written before
// A3's auth module existed — these are `@db.Uuid`, matching `AccessGrant`
// and `Consent`'s already-real `patientId`. Two separate models, not one
// generic grant table (`AccessGrant` above is exactly that shape and is
// deliberately left unused rather than repurposed): family-and-proxy.md §2
// is explicit that conflating guardianship and delegation is the failure
// mode, and `AccessGrant` also has no field for assisted-enrolment consent,
// which `DelegationGrant.enrolmentMethod` requires can never be silently
// dropped.

model GuardianshipGrant {
  id         String              @id @default(uuid()) @db.Uuid
  wardId     String              @db.Uuid
  guardianId String              @db.Uuid
  grounds    GuardianshipGrounds
  grantedAt  DateTime
  /**
   * Mandatory in `packages/family`'s own type — never nullable here either.
   */
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([guardianId])
  @@index([wardId])
}

model DelegationGrant {
  id                  String            @id @default(uuid()) @db.Uuid
  granterId           String            @db.Uuid
  delegateId          String            @db.Uuid
  scopes              DelegationScope[]
  grantedAt           DateTime
  expiresAt           DateTime
  revokedAt           DateTime?
  // Mirrors `AssistedEnrolmentConsent | null` as a nullable pair rather than
  // a nested Json blob: both columns are null together (self-service grant)
  // or set together (assisted enrolment) — see `PrismaFamilyGrantsStore`,
  // which enforces that pairing on every read and write, for why a typed
  // pair beats an untyped object here.
  enrolmentMethod     ConsentMethod?
  enrolmentRecordedBy String?           @db.Uuid

  @@index([delegateId])
  @@index([granterId])
}
