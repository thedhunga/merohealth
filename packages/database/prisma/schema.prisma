generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  GUARDIAN
  CAREGIVER
  DOCTOR
  NURSE
  PHARMACIST
  LAB_PROVIDER
  DELIVERY_PARTNER
  ORG_ADMIN
  CLINICAL_REVIEWER
  SUPPORT
  SUPER_ADMIN
}

enum VerificationStatus {
  CLAIMED
  IMPORTED
  REVIEWED
  VERIFIED
  SUSPENDED
  RETIRED
}

enum ConsentStatus {
  DRAFT
  GRANTED
  REVOKED
  EXPIRED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PrescriptionStatus {
  DRAFT
  READY_FOR_SIGNATURE
  SIGNED
  TRANSMITTED
  CANCELLED
  AMENDED
  EXPIRED
}

enum PharmacyOrderStatus {
  REQUESTED
  AWAITING_PRESCRIPTION_VALIDATION
  QUOTED
  AWAITING_PATIENT_APPROVAL
  ACCEPTED
  PHARMACIST_REVIEW
  CLARIFICATION_REQUIRED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

// Mirrors packages/health-records's DocumentStatus exactly — that package
// owns the transition rules (canTransition); this enum just has to keep the
// same members so a row can never hold a status the domain logic disallows.
enum DocumentStatus {
  CAPTURED
  UPLOADING
  STORED
  EXTRACTING
  AWAITING_CONFIRMATION
  CONFIRMED
  EXTRACTION_FAILED
  DELETED
}

// Mirrors packages/health-records's ObservationStatus. Only CONFIRMED and
// CORRECTED rows are trusted (see selectTrusted) — a DRAFT extraction must
// never reach the assistant, a share link or an export.
enum ObservationStatus {
  DRAFT
  CONFIRMED
  CORRECTED
  REJECTED
}

// Mirrors shared-types's PlanTier. The plan catalogue itself (pricing,
// modules, limits) stays code-defined in packages/entitlements — this enum
// only records which tier a given owner is currently on.
enum PlanTier {
  FREE
  PLUS
  PRO
}

// Mirrors shared-types's QuotaDimension.
enum QuotaDimension {
  DOCUMENTS_STORED
  EXTRACTION_PAGES_PER_MONTH
  ASSISTANT_MESSAGES_PER_MONTH
  ACTIVE_SHARE_LINKS
  CONNECTED_DEVICES
}

// Mirrors packages/family's GuardianshipGrounds, DelegationScope and
// ConsentMethod exactly — see GuardianshipGrant/DelegationGrant below for
// why these are real enums (a closed set the package itself never widens)
// rather than the plain String/Json this file uses for fields no domain
// package constrains yet (e.g. AccessGrant.scopes, Consent.evidence).
enum GuardianshipGrounds {
  MINOR
  INCAPACITY
}

enum DelegationScope {
  VIEW_RECORD
  ASK_ASSISTANT
  MANAGE_APPOINTMENTS
  UPLOAD_DOCUMENTS
}

enum ConsentMethod {
  IN_PERSON_VERBAL
  WITNESSED
  CLINICIAN_ATTESTED
  WRITTEN
}

model User {
  id         String    @id @default(uuid()) @db.Uuid
  email      String?   @unique
  phone      String?   @unique
  role       UserRole
  locale     String    @default("ne")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  disabledAt DateTime?
  version    Int       @default(1)
}

// Round two A3 (phone + OTP). One row per code sent; `codeHash` is an HMAC,
// never the code itself — see packages/auth's own doc comment on why a bare
// hash of a six-digit code isn't enough. `phone` is deliberately not unique:
// the same number legitimately gets several challenges over time (resends,
// a later sign-in), unlike `User.phone` which is the one-account-per-number
// constraint.
model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

// A session per issued token, not per user — nothing here caps concurrent
// sessions, so the same person can be signed in on `apps/web` and
// `apps/mobile` at once. `userId` is a plain scalar, not `@relation(User)`,
// matching this file's `User` model itself having no relations to anything.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

