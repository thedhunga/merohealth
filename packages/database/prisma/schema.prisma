}

// Replaces the pre-pivot Subscription model this file used to define
// (subscriberType/subscriberId/planId against a DB-driven Plan catalogue).
// Nothing in the codebase ever read that model (confirmed by grep before
// this change), and it modelled a plan catalogue stored in the database —
// this product's catalogue is code-defined in packages/entitlements, so a
// subscription only needs to record which tier an owner is on, not a
// foreign key into a `Plan` table. `Plan`/`Entitlement` below are left
// untouched; whether they still belong is a separate decision.
//
// This is the real store `FreeTierSubscriptionResolver`
// (apps/api/src/entitlements/subscription-resolver.ts) names as its own
// replacement — wiring a resolver against it is future work, not this task.
model Subscription {
  id                 String    @id @default(uuid()) @db.Uuid
  ownerId            String    @unique
  tier               PlanTier  @default(FREE)
  status             String    @default("ACTIVE")
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  version            Int       @default(1)
}

// One row per (owner, dimension, period). `period` is "YYYY-MM" for the
// two monthly-reset dimensions and the sentinel "ALL_TIME" for the rest, so
// the unique constraint holds regardless of dimension — a nullable period
// column would not: Postgres treats every NULL as distinct, which would
// silently defeat uniqueness for the non-monthly rows.
model UsageCounter {
  id        String         @id @default(uuid()) @db.Uuid
  ownerId   String
  dimension QuotaDimension
  period    String
  count     Int            @default(0)
  updatedAt DateTime       @updatedAt

  @@unique([ownerId, dimension, period])
}

