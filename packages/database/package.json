{
  "name": "@swasthya/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "prisma generate",
    "generate": "prisma generate",
    "validate": "prisma validate",
    "migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "lint": "prisma format --check && prisma generate && eslint src prisma/seed.ts",
    "typecheck": "prisma validate && prisma generate && tsc -p tsconfig.json",
    "test": "prisma generate && vitest run src"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@swasthya/shared-types": "workspace:*"
  },
  "devDependencies": {
    "prisma": "7.9.1",
    "tsx": "4.23.9",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
