# Copy to /opt/mero-health/.env.server on the server and run: chmod 600 .env.server
# Existing multi-site servers should keep this loopback-only and reverse proxy through Apache.
MERO_BIND_IP=127.0.0.1
MERO_HTTP_PORT=8090
# Only used with: docker compose --profile standalone up -d
MERO_DOMAIN=:80
PERPLEXITY_API_KEY=replace-with-a-server-side-api-key
PERPLEXITY_MODEL=sonar-pro
ALLOWED_ORIGINS=http://94.130.110.253
