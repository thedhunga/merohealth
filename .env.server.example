# Copy to /opt/mero-health/.env.server on the server and run: chmod 600 .env.server
# Existing multi-site servers should keep this loopback-only and reverse proxy through Apache.
MERO_BIND_IP=127.0.0.1
MERO_HTTP_PORT=8090
# Only used with: docker compose --profile standalone up -d
MERO_DOMAIN=:80

# Database. compose.server.yaml creates the postgres service from these; the
# API and the migrate step derive DATABASE_URL from them automatically.
POSTGRES_DB=mero_health
POSTGRES_USER=mero
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Research provider. Gemini is free-tier and preferred; Perplexity is optional.
GEMINI_API_KEY=replace-with-a-server-side-api-key
# PERPLEXITY_API_KEY=
# RESEARCH_PROVIDER=gemini

# Browsers allowed to call this API with cookies. Comma-separated, no trailing
# slash. Must include the Vercel site (and later the real domain), or sign-in
# from the website fails at CORS before it reaches any route.
ALLOWED_ORIGINS=https://merohealth-beta.vercel.app

# Session cookies are SameSite=None; Secure automatically when NODE_ENV is
# production (the website on Vercel and this API are different hosts). That
# means this API must only ever be served over HTTPS, or browsers drop the
# cookie and every sign-in silently fails.
