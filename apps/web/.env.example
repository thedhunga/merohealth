# Copy this file to apps/web/.env.local for local Next.js development.
# Never prefix private provider keys with NEXT_PUBLIC_.
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Google Sign-In button (GoogleSignInButton.tsx). Public and build-time —
# baked into the bundle, so a value change needs a rebuild. Unset hides the
# button entirely; apps/api's own GOOGLE_CLIENT_ID (root .env.example) is a
# separate OAuth client and must be set to the same one for the two sides to
# agree. See docs/product/agent-progress.md, Round three §D.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Research provider. Gemini is preferred when both keys exist (free tier);
# set RESEARCH_PROVIDER=perplexity to force the other. Server-only — never NEXT_PUBLIC_.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.7-flash   # optional; the provider walks a built-in list of current Flash models when unset
# RESEARCH_PROVIDER=gemini

# Redeploy marker: env vars are baked at build time; a change under apps/web forces a real build.
