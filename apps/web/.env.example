# Copy this file to apps/web/.env.local for local Next.js development.
# Never prefix private provider keys with NEXT_PUBLIC_.
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Google Sign-In button (GoogleSignInButton.tsx). Public and build-time —
# baked into the bundle, so a value change needs a rebuild. Unset hides the
# button entirely; apps/api's own GOOGLE_CLIENT_ID (root .env.example) is a
# separate OAuth client and must be set to the same one for the two sides to
# agree. See docs/product/agent-progress.md, Round three §D.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Research provider. Gemini is preferred when both keys exist (free tier);
# set RESEARCH_PROVIDER=perplexity to force the other. Server-only — never NEXT_PUBLIC_.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.7-flash   # optional; the provider walks a built-in list of current Flash models when unset
# RESEARCH_PROVIDER=gemini

# Freemium voice minutes (apps/web/src/content/pricing.ts), Round six §L —
# see docs/product/freemium-and-voice-corpus.md §2. Public, build-time,
# whole NPR. Owner sets these; unset means the /pricing page shows a "price
# soon" state instead of a guessed number.
NEXT_PUBLIC_TRIAL_MINUTES_FREE=
NEXT_PUBLIC_PRICE_PLUS_NPR=
NEXT_PUBLIC_MINUTES_PLUS=
NEXT_PUBLIC_PRICE_PRO_NPR=
NEXT_PUBLIC_MINUTES_PRO=

# Redeploy marker: env vars are baked at build time; a change under apps/web forces a real build.

# Search grounding is NOT in Gemini's free tier: on a free key every grounded
# request is refused (429) while plain requests succeed. Two ways forward:
#   1. Enable billing on the Google Cloud project behind the key — grounding
#      then works and answers carry live citations. Preferred.
#   2. Let the assistant answer WITHOUT live sources (labelled gemini-ungrounded,
#      no citations, stronger disclaimer). This is the current default by owner
#      decision (2026-08-17). Set to false to fail closed once billing is on.
# RESEARCH_ALLOW_UNGROUNDED=true
