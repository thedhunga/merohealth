{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".expo/**", ".next/**", "!.next/cache/**"],
      "env": [
        "EXPO_PUBLIC_API_URL",
        "EXPO_UNSTABLE_METRO_OPTIMIZE_GRAPH",
        "EXPO_UNSTABLE_TREE_SHAKING"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}

